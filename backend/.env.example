# Okoa Float Leave Management System
DB_NAME=Okoa_Float_DB
DB_PASSWORD=your-database-password
DB_USER=your-database-user
DB_HOST=localhost
DB_PORT=3306
JWT_SECRET_KEY=replace-with-a-random-secret
HR_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
SECRET_KEY=replace-with-a-random-secret
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=your-admin-email@example.com
FLASK_APP=run.py
FLASK_ENV=development

# Development OTP codes are stored in the database and written to the backend console.
BACKEND_PORT=5000

# SMS Configuration (Onfon Media Bulk SMS API)
SMS_ENABLED=true
ONFON_SMS_URL=https://api.onfonmedia.com/v1/sms/SendBulkSMS
ONFON_ACCESS_KEY=your-onfon-access-key
ONFON_API_KEY=your-onfon-api-key
ONFON_CLIENT_ID=your-onfon-client-id
ONFON_SENDER_ID=OkoaFloat

# OTP email delivery (used alongside SMS)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=your-verified-sender@example.com
MAIL_USE_TLS=true
MAIL_USE_SSL=false
